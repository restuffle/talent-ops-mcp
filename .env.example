# Copy to .env and edit. Never commit .env.
#
# Every setting is optional -- the defaults below are what the server uses when the
# variable is absent. mcp 2.0.0 no longer reads MCP_* or .env itself, so this file is
# consumed solely by talent_ops_mcp.settings via pydantic-settings.
#
# Do not put machine-specific absolute paths in a committed file. Paths shown here are
# relative to the process working directory.

# development | test | production
TALENT_OPS_ENV=development

# Root directory the server is allowed to touch. The SQLite database must resolve
# inside it; anything outside is rejected at startup.
TALENT_OPS_DATA_DIR=data

# SQLite file. Relative paths resolve under TALENT_OPS_DATA_DIR.
# Default when unset: <TALENT_OPS_DATA_DIR>/talent_ops.sqlite3
# TALENT_OPS_DATABASE_PATH=talent_ops.sqlite3

# CRITICAL | ERROR | WARNING | INFO | DEBUG -- always written to stderr, never stdout.
TALENT_OPS_LOG_LEVEL=INFO

# How long a scheduling preview's confirmation token stays valid (30-3600).
TALENT_OPS_PREVIEW_TTL_SECONDS=600

# Upper bound on any list tool's page size (1-200).
TALENT_OPS_MAX_PAGE_SIZE=50

# Upper bound on any scheduling or reporting date range, in days (1-90).
TALENT_OPS_MAX_DATE_RANGE_DAYS=31

# Slot alignment grid for the scheduling engine, in minutes (5-60).
TALENT_OPS_SLOT_INTERVAL_MINUTES=15
